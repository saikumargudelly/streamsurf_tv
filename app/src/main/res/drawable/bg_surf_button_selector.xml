<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00E5FF"
                android:endColor="#2979FF"
                android:angle="45" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_elevated" />
            <stroke android:width="1.5dp" android:color="@color/divider_light" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
